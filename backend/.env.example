# Server
PORT=5000
NODE_ENV=production

# CORS - must be the deployed frontend origin (no trailing slash)
CLIENT_URL=https://ceypetco.vercel.app

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://user:pass@cluster0.mongodb.net/ceypetco

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=24h

# Cloudinary (for image/document uploads). Or provide CLOUDINARY_URL=cloudinary://KEY:SECRET@CLOUD_NAME
CLOUDINARY_CLOUD_NAME=e9fb61tl
CLOUDINARY_API_KEY=138491812554666
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
